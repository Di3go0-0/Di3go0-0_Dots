/* Theme rofi compacto: prompt "Todos / Solo actual" */

* {
    bg:         #0f121c;
    bg-alt:     #1f2536;
    fg:         #cdd6f4;
    accent:     #89b4fa;
    accent-sel: #3a4a7a;
    border:     #4a5b8a;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            420px;
    background-color: @bg;
    border:           2px;
    border-color:     @border;
    border-radius:    14px;
    padding:          18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  14px;
}

inputbar {
    background-color: @bg-alt;
    padding:          10px 14px;
    border-radius:    8px;
    children:         [ prompt ];
}

prompt {
    text-color: @accent;
}

listview {
    columns: 1;
    lines:   2;
    spacing: 6px;
}

element {
    padding:       12px 14px;
    border-radius: 8px;
}

element selected {
    background-color: @accent-sel;
    text-color:       @fg;
}
