// [GLASS] rofi -show drun launcher. Theme base + tweaks de layout.
configuration {
    modes:              "drun,run,window,ssh";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    drun-display-format: "{icon} {name}";
    matching:           "regex";
    drun-match-fields:  "name";
    display-drun:       "Apps:";
    display-run:        "Menu:";
    display-ssh:        "SSH:";
    display-window:     "Windows:";
}

@theme "~/.config/rofi/themes/glass.rasi"

/* ---- overrides específicos del launcher ---- */
window {
    location:       center;
    width:          520px;
    y-offset:       -30px;
}

mainbox {
    children: [ inputbar, listview ];
}

listview {
    columns:      1;
    lines:        8;
    spacing:      4px;
    fixed-height: false;
}

element-icon {
    size:           1.6em;
}

element {
    padding:        10px 14px;
}
