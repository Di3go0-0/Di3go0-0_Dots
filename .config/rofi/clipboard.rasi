// [GLASS] cliphist menu. Theme base + tweaks compactos.
// Tamaño dinámico: no impone 12 filas vacías cuando solo hay 5 items.
configuration {
    modi:        "drun";
    show-icons:  false;
}

@theme "~/.config/rofi/themes/glass.rasi"

/* ---- overrides para cliphist ---- */
window {
    width:    28em;
    /* height omitido → encoge al contenido. cliphist.sh sobrescribe location. */
}

mainbox {
    children: [ inputbar, listview ];
}

listview {
    columns:         1;
    lines:           10;
    spacing:         3px;
    fixed-num-lines: false;
    fixed-height:    false;
    cycle:           true;
    scrollbar:       true;
}

/* Altura uniforme por fila (limitación de rofi) → mantener icon razonable
   para no inflar las filas de texto plano. 40px = preview visible + filas compactas. */
element {
    padding: 4px 10px;
    spacing: 10px;
}

element-icon {
    size:   32px;
    expand: false;
}
